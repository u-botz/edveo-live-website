{
  "name": "edveo-live-website",
  "version": "1.0.0",
  "private": true,
  "description": "Live teaching website and Google onboarding into the existing Edveo platform",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4173",
    "build": "next build",
    "build:export": "node scripts/export.mjs",
    "start": "next start --hostname 127.0.0.1 --port 4173",
    "check": "tsc --noEmit",
    "check:export": "node scripts/check-export.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
